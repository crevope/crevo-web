# ─── API (REQUIRED) ──────────────────────────────────────────────────────────
# Two valid forms:
#
#   1) Relative path (recommended in dev):
#        NEXT_PUBLIC_API_URL=/api
#        BACKEND_UPSTREAM_URL=http://localhost:3000
#      The SPA calls `/api/*` on its own origin and Next.js proxies each hit
#      to BACKEND_UPSTREAM_URL. Keeps auth cookies same-origin.
#
#   2) Full URL (production when frontend and API share a registrable domain,
#      e.g. app.crevo.pe + api.crevo.pe with COOKIE_DOMAIN=.crevo.pe on the
#      backend):
#        NEXT_PUBLIC_API_URL=https://api.crevo.pe/api
#        # BACKEND_UPSTREAM_URL not needed
NEXT_PUBLIC_API_URL=/api
BACKEND_UPSTREAM_URL=http://localhost:3000

# ─── Supabase (REQUIRED) ─────────────────────────────────────────────────────
# Public anon key — only used for Realtime broadcast subscriptions.
# Sensitive data is always fetched through the backend with the user's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Culqi (payments — optional) ─────────────────────────────────────────────
# Public key from https://culqi.com → Dashboard → Development → API Keys.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# ─── Firebase Cloud Messaging (push notifications — optional) ────────────────
# Get these at Firebase Console → Project Settings → General → Your apps → Web SDK.
# All NEXT_PUBLIC_FIREBASE_* values are required together; leave blank to disable push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=crevo-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=crevo-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=crevo-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID public key for browser push: Firebase Console → Cloud Messaging → Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Facebook App ID (analytics — optional) ─────────────────────────────────
# Emits <meta property="fb:app_id"> in the page <head>. Required ONLY if you
# want Facebook Insights (analytics on URL shares/comments/reactions) or the
# official Like button. Link previews work fine without it — Facebook's
# debugger will show a "missing fb:app_id" warning that you can ignore.
#
# To create: https://developers.facebook.com/apps/ → Create App → Business
# type → copy the App ID (15–16 digits).
NEXT_PUBLIC_FB_APP_ID=

# ─── Search engine verification (SEO — recommended) ──────────────────────────
# Tokens that prove ownership of crevo.pe to Google / Bing so you can access
# their webmaster tools (impressions, click-through, indexing, errors).
# When set, emit <meta name="google-site-verification"> / <meta name="msvalidate.01">.
# Step-by-step setup is in docs/SEO.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Sentry (error monitoring — recommended) ─────────────────────────────────
# DSN at https://sentry.io → Settings → Projects → your-project → DSN.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Build-time only (CI/CD) — used to upload source maps. Safe to leave blank locally.
SENTRY_ORG=crevope
SENTRY_PROJECT=crevo-web
SENTRY_AUTH_TOKEN=sntrys_xxxx
